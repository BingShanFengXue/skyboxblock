# 文本统一以 LF 存库；Windows 批处理保留 CRLF。
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制（不做换行/编码转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.hdr binary
*.zip binary
*.jar binary
*.nbt binary

# 上游许可原文与素材清单按字节保存（证据副本不做换行归一化）
docs/third-party-evidence/*.txt -text
docs/third-party-evidence/*.csv -text
